{
  "realm": "orderflow",
  "enabled": true,
  "displayName": "OrderFlow",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Creates and reads owned orders"
      },
      {
        "name": "OPERATOR",
        "description": "Supports and reads all orders"
      }
    ]
  },
  "clients": [
    {
      "clientId": "orderflow-api",
      "name": "OrderFlow API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*/*"
      ],
      "webOrigins": [
        "http://localhost:*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orderflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orderflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer.demo",
      "enabled": true,
      "email": "customer.demo@orderflow.local",
      "emailVerified": true,
      "firstName": "OrderFlow",
      "lastName": "Customer",
      "realmRoles": ["CUSTOMER"],
      "credentials": [
        {
          "type": "password",
          "value": "orderflow_customer_dev",
          "temporary": false
        }
      ]
    }
  ]
}
